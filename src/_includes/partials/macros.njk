{% macro wallpaperCard(item) %}
<a class="wall-card reveal" href="{{ item.url }}" data-card
   data-category="{{ item.data.category }}"
   data-type="{{ item.data.type }}"
   data-search="{{ item.data.title }} {{ (item.data.tags_list or []) | join(' ') }} {{ item.data.category }}">
  {% if item.data.type == "live" %}
  <span class="live-badge">Live</span>
  <img class="blur-up" src="{{ item.data.video_poster }}" alt="{{ item.data.title }}" loading="lazy" width="700" height="900">
  <video class="card-hover-video" data-src="{{ item.data.video_phone }}" muted loop playsinline preload="none"></video>
  {% else %}
  <img class="blur-up" src="{{ item.data.image_thumb }}" alt="{{ item.data.title }}" loading="lazy" width="700" height="900">
  {% endif %}
  <span class="wall-meta"><span class="title">{{ item.data.title }}</span></span>
</a>
{% endmacro %}

{% macro adSlot(slot) %}
{% if site.ads_enabled and site.adsense_client_id %}
<div class="ad-slot is-live">
  <ins class="adsbygoogle"
       style="display:block; width:100%;"
       data-ad-client="{{ site.adsense_client_id }}"
       data-ad-slot="{% if slot == 'leaderboard' %}{{ site.adsense_slot_leaderboard }}{% else %}{{ site.adsense_slot_in_feed }}{% endif %}"
       data-ad-format="auto"
       data-full-width-responsive="true"></ins>
  <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
</div>
{% else %}
<div class="ad-slot">Ad space — connect AdSense in the admin panel to activate this slot</div>
{% endif %}
{% endmacro %}
